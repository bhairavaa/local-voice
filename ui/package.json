{
  "name": "local-ai-assistant-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interface for Local AI Assistant, rendered inside the Tauri desktop shell",
  "scripts": {
    "dev": "vite",
    "generate:types": "openapi-typescript ../schema/openapi.json -o src/services/generated/engine.ts",
    "prebuild": "npm run generate:types",
    "build": "tsc --noEmit && vite build",
    "pretypecheck": "npm run generate:types",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.0.0",
    "openapi-typescript": "^7.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0"
  }
}
